# ── Windows batch / PowerShell скриптүүд ────────────────
# cmd.exe нь CRLF мөрийн төгсгөл ШААРДДАГ. LF байвал мөрүүдийг дунднаас
# нь тасалж, хэсэг бүрийг тусад нь команд болгон ажиллуулж эвдэрнэ.
# Clone хийж буй компьютерийн core.autocrlf тохиргооноос үл хамааран
# ҮРГЭЖ CRLF-ээр гаргана.
#
# ЧУХАЛ ДҮРЭМ: install.bat, License.bat, Run.bat, Stop.bat, bootstrap.ps1
# нь зөвхөн ASCII үсэг агуулна. Windows-ийн консол растер фонттой үед
# кирилл үсгийг "?" болгодог тул бүх медэгдлийг латинаар бичсэн.
# Кирилл текст зөвхөн ХӨТЧИД харагдах хэсэгт (LicenseGate, API) үлдэнэ.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# ── Лицензийн хоёртын файл ──────────────────────────────
# Шифрлэгдсэн хувийн түлхүүр — мөрийн төгсгөл хөрвүүлбэл ГЭМТЭНЭ.
backend/licensing/vault.dat  binary

# ── Бусад хоёртын файлууд ───────────────────────────────
*.db     binary
*.sqlite binary
*.png    binary
*.jpg    binary
*.ico    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
