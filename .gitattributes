# ── Windows batch файлууд ───────────────────────────────
# cmd.exe нь CRLF мөрийн төгсгөл ШААРДДАГ. LF байвал мөрүүдийг дунднаас
# нь тасалж, хэсэг бүрийг тусад нь команд болгон ажиллуулж эвдэрнэ.
# Clone хийж буй компьютерийн core.autocrlf тохиргооноос үл хамааран
# ҮРГЭЛЖ CRLF-ээр гаргана.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# ── PowerShell скриптүүд ────────────────────────────────
# tools/bootstrap.ps1 нь UTF-8 BOM-той байх ЁСТОЙ. BOM-гүй бол
# Windows PowerShell 5.1 нь кирилл үсгийг ANSI гэж уншиж эвдэнэ.
# (git BOM-ыг хөндөхгүй — зөвхөн мөрийн төгсгөлийг жигдрүүлнэ.)
*.ps1  text eol=crlf

# ── Лицензийн хоёртын файл ──────────────────────────────
# Шифрлэгдсэн хувийн түлхүүр — мөрийн төгсгөл хөрвүүлбэл ГЭМТЭНЭ.
backend/licensing/vault.dat  binary

# ── Бусад хоёртын файлууд ───────────────────────────────
*.db     binary
*.sqlite binary
*.png    binary
*.jpg    binary
*.ico    binary
*.ttf    binary
*.woff   binary
*.woff2  binary
