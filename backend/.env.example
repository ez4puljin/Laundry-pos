# Энэ файлыг .env нэрээр хуулж, өөрийн утгуудаа бөглөнө үү:
#   copy .env.example .env
# .env файл нь git-д ОРОХГҮЙ (.gitignore-д бүртгэлтэй).

# ── JWT токены нууц түлхүүр ──────────────────────────────
# Санамсаргүй урт мөр үүсгэж тавина. Жишээ:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=''

# ── Android SMS Gateway тохиргоо ─────────────────────────
# Утасны app дээр харагдах Local address
SMS_GATEWAY_URL='http://192.168.1.10:8080'

# Утасны app дээр харагдах Username / Password
SMS_GATEWAY_USERNAME=''
SMS_GATEWAY_PASSWORD=''

# SMS явуулах эсэх (true / false)
SMS_ENABLED='false'

# Явуулах мессежний текст
SMS_TEMPLATE='Таны угаалга бэлэн боллоо.'

# ── Лояалти оноо ─────────────────────────────────────────
POINTS_ENABLED='false'
POINTS_EARN_RATE='10.0'

# ── Баримт дээр хэвлэгдэх мэдээлэл ───────────────────────
RECEIPT_SHOP_NAME='LAUNDRY'
RECEIPT_SHOP_DESC='Угаалгын үйлчилгээ'
RECEIPT_SHOP_PHONE=''
RECEIPT_FOOTER_TEXT='Үйлчлүүлсэнд Баярлалаа!'
RECEIPT_FOOTER_SUB=''
